module;
#include <cstddef>
#include <memory_resource>

export module mmwave.radar:fft;

import :types;

extern "C" {
#include "fftw3.h"
}

namespace mmwave::radar {

constexpr auto FORWARD = FFTW_FORWARD;
constexpr auto ESTIMATE = FFTW_ESTIMATE;

export class FFTWMemPool final : public std::pmr::memory_resource {

public:
  FFTWMemPool() = default;

  FFTWMemPool(const FFTWMemPool &) = delete;

  FFTWMemPool &operator=(const FFTWMemPool &) = delete;

private:
  void *do_allocate(std::size_t bytes, std::size_t alignment) override {
    // FFTW guarantees SIMD alignment
    if (auto ptr = fftwf_malloc(bytes))
      return ptr;

    throw std::bad_alloc{};
  }

  void do_deallocate(void *ptr, std::size_t, std::size_t) override {
    fftwf_free(ptr);
  }

  bool
  do_is_equal(const std::pmr::memory_resource &other) const noexcept override {
    return this == &other;
  }
};
class FFTWPlan {

public:
  FFTWPlan() = default;

  FFTWPlan(fftwf_plan plan) noexcept;

  ~FFTWPlan();

  FFTWPlan(const FFTWPlan &) = delete;
  FFTWPlan &operator=(const FFTWPlan &) = delete;

  FFTWPlan(FFTWPlan &&other) noexcept;

  FFTWPlan &operator=(FFTWPlan &&other) noexcept;

  explicit operator bool() const noexcept { return plan_ != nullptr; }

  void execute() noexcept;

private:
  void reset() noexcept;
  fftwf_plan plan_{nullptr};
};

export class RadarFFT {
public:
  RadarFFT(ComplexView input, ComplexView output);

  void range_fft();

  void doppler_fft(ComplexView input, ComplexView output);

private:
  FFTWPlan plans_[2];
};

} // namespace mmwave::radar
