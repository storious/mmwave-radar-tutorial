module;
#include <cstddef>
#include <memory_resource>

export module mmwave.radar:fft;

import :types;

extern "C" {
#include "fftw3.h"
}

export namespace mmwave::radar {

constexpr auto FORWARD = FFTW_FORWARD;
constexpr auto ESTIMATE = FFTW_ESTIMATE;

class FFTWMemPool final : public std::pmr::memory_resource {

public:
  FFTWMemPool() = default;

  FFTWMemPool(const FFTWMemPool &) = delete;

  FFTWMemPool &operator=(const FFTWMemPool &) = delete;

private:
  void *do_allocate(std::size_t bytes, std::size_t alignment) override {
    // FFTW guarantees SIMD alignment
    if (auto ptr = fftw_malloc(bytes))
      return ptr;

    throw std::bad_alloc{};
  }

  void do_deallocate(void *ptr, std::size_t, std::size_t) override {
    fftw_free(ptr);
  }

  bool
  do_is_equal(const std::pmr::memory_resource &other) const noexcept override {
    return this == &other;
  }
};

class FFTWPlan {

public:
  FFTWPlan() = default;

  FFTWPlan(fftw_plan plan) noexcept;

  ~FFTWPlan() { reset(); }

  FFTWPlan(const FFTWPlan &) = delete;

  FFTWPlan &operator=(const FFTWPlan &) = delete;

  FFTWPlan(FFTWPlan &&other) noexcept : plan_(other.plan_) {
    other.plan_ = nullptr;
  }

  FFTWPlan &operator=(FFTWPlan &&other) noexcept {
    if (this != &other) {
      reset();
      plan_ = other.plan_;
      other.plan_ = nullptr;
    }

    return *this;
  }

  void execute() noexcept {
    if (plan_)
      fftw_execute(plan_);
  }

  void reset() noexcept {
    if (plan_) {
      fftw_destroy_plan(plan_);
      plan_ = nullptr;
    }
  }

  explicit operator bool() const noexcept { return plan_ != nullptr; }

private:
  fftw_plan plan_{nullptr};
};

class RadarFFT {
public:
  explicit RadarFFT(std::pmr::memory_resource *resource)
      : resource_(resource) {};

  FFTWPlan create_1d_plan(int n, fftw_complex *in, fftw_complex *out);

  static FrameView run_1d(ConstFrameView input) noexcept;
  static FrameView run_2d(ConstFrameView input) noexcept;

private:
  std::pmr::memory_resource *resource_;
};

} // namespace mmwave::radar
